{
  "name": "网页打印助手",
  "description": "选择打印 - 框选页面区域，干净打印",
  "version": "1.0.0",
  "manifest_version": 3,
  "action": {

    "default_icon": "logo.png"
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["libs/Readability.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab"
  ]
}
